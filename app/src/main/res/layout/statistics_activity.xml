<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">


    <include
        layout="@layout/header"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="70dp"
        android:paddingBottom="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <HorizontalScrollView
                android:id="@+id/horizontal_scroll_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_revenue"
                        android:layout_width="160dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp"
                        app:cardForegroundColor="#10000000">

                        <RelativeLayout
                            android:id="@+id/revenue_statistics_relative_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/primary_gradient"
                            android:padding="16dp">


                            <TextView
                                android:id="@+id/textview_revenue_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Revenue"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textview_revenue_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/textview_revenue_title"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:src="@android:drawable/ic_menu_slideshow"
                                app:tint="@color/primary_color" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_product"
                        android:layout_width="160dp"
                        android:layout_height="110dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp">

                        <RelativeLayout
                            android:id="@+id/products_statistics_relative_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp">


                            <TextView
                                android:id="@+id/textview_product_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Products"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textview_product_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/textview_product_title"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:src="@android:drawable/ic_menu_agenda"
                                app:tint="@color/primary_color" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_staff"
                        android:layout_width="160dp"
                        android:layout_height="110dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp">

                        <RelativeLayout
                            android:id="@+id/staff_statistics_relative_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp">


                            <TextView
                                android:id="@+id/textview_staff_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Staff"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textview_staff_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/textview_staff_title"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:src="@android:drawable/ic_menu_myplaces"
                                app:tint="@color/primary_color" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Main Graph Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_main_graph"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_below="@id/horizontal_scroll_metrics"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <!-- North West: Title -->
                    <TextView
                        android:id="@+id/textview_graph_main_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sales Performance"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- North East: Date Selectors and Submit -->
                    <LinearLayout
                        android:id="@+id/linearlayout_date_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textview_start_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:padding="4dp"
                            android:text="01/08/2002"
                            android:textColor="@color/primary_color"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" - "
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/textview_end_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:padding="4dp"
                            android:text="20/06/2026"
                            android:textColor="@color/primary_color"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_submit_dates"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:padding="4dp"
                            android:text="GO"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Center North: Indicator -->
                    <TextView
                        android:id="@+id/textview_graph_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/linearlayout_date_controls"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:text="1/2"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Main Content: ViewPager for Charts -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewpager_charts"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@id/textview_graph_indicator"
                        android:layout_marginTop="16dp" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Success/Mid/Worst Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_success_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/card_main_graph"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textview_efficiency_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Operational Efficiency"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textview_efficiency_title"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <!-- Most Successful -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">

                            <View
                                android:id="@+id/view_success_dot"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_centerVertical="true"
                                android:background="@drawable/circle_green" />

                            <TextView
                                android:id="@+id/textview_success_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@id/view_success_dot"
                                android:text="Most Successful"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textview_success_percentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="100%-70%"
                                android:textColor="@color/success_green"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Mid Successful -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">

                            <View
                                android:id="@+id/view_mid_dot"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_centerVertical="true"
                                android:background="@drawable/circle_orange" />

                            <TextView
                                android:id="@+id/textview_mid_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@id/view_mid_dot"
                                android:text="Mid Successful"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textview_mid_percentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="70%-50%"
                                android:textColor="@color/warning_orange"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Worst Successful -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <View
                                android:id="@+id/view_worst_dot"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_centerVertical="true"
                                android:background="@drawable/circle_red" />

                            <TextView
                                android:id="@+id/textview_worst_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@id/view_worst_dot"
                                android:text="Worst Successful"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textview_worst_percentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="50%-"
                                android:textColor="@color/error_red"
                                android:textStyle="bold" />
                        </RelativeLayout>

                    </LinearLayout>

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Product/Price Data List -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_product_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/card_success_metrics"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textview_product_list_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Sales Breakdown"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/linearlayout_product_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textview_product_list_title"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">
                        <!-- Data will be populated here -->
                    </LinearLayout>

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>
        <!-- Top Section: Metric Cards -->
    </ScrollView>
</RelativeLayout>
